// Zellij — Yev Design System v0.2
//
// Quiet chrome: the bar is ink, inactive tabs are warm neutral, the active
// tab and focused pane are paper. Yev Signal only appears while a transient
// mode (pane, tab, resize, move, scroll, session) is active: it marks "you
// are not in normal mode" and disappears when you leave it.
//
// Ergonomics (macOS, right-handed): Alacritty maps only the LEFT Option key
// to Alt, so every binding below is "left Option + key". Frequent actions
// sit under the left hand (1-5, q-t, a-g, z-v) so the right hand can stay
// on the trackpad. hjkl / arrows are for when both hands are on the keys.
// Alt b / f / d / . are left free for zsh word motions.

theme "yev"
default_layout "yev"
default_mode "normal"

simplified_ui true
pane_frames true
mouse_mode true
copy_on_select true
copy_command "pbcopy"
scroll_buffer_size 10000
scrollback_editor "/opt/homebrew/bin/nvim"
auto_layout true
on_force_close "detach"
show_startup_tips false
show_release_notes false
visual_bell false
styled_underlines true

ui {
    pane_frames {
        rounded_corners false
        hide_session_name true
    }
}

themes {
    // Mapping (0.42+ component spec):
    //   bar / text      ink background, muted text
    //   mode indicator  NORMAL muted (emphasis_2), LOCKED sand (emphasis_3),
    //                   any transient mode Yev Signal (emphasis_0)
    //   tabs            inactive warm neutral, active paper, no zebra striping
    //   frames          unfocused edge, focused paper, focused-in-a-mode Signal
    //   exit codes      semantic green / red, never Signal
    yev {
        text_unselected {
            base "#A49E94"
            background "#11100E"
            emphasis_0 "#FF4D1F"
            emphasis_1 "#C8BDAA"
            emphasis_2 "#A49E94"
            emphasis_3 "#C8BDAA"
        }
        text_selected {
            base "#F2EFE8"
            background "#24221E"
            emphasis_0 "#FF4D1F"
            emphasis_1 "#C8BDAA"
            emphasis_2 "#A49E94"
            emphasis_3 "#C8BDAA"
        }
        ribbon_unselected {
            base "#11100E"
            background "#8B857C"
            emphasis_0 "#B3263A"
            emphasis_1 "#8B857C"
            emphasis_2 "#11100E"
            emphasis_3 "#B3263A"
        }
        ribbon_selected {
            base "#11100E"
            background "#F2EFE8"
            emphasis_0 "#B3263A"
            emphasis_1 "#C8BDAA"
            emphasis_2 "#11100E"
            emphasis_3 "#B3263A"
        }
        table_title {
            base "#F2EFE8"
            background "#11100E"
            emphasis_0 "#FF4D1F"
            emphasis_1 "#C8BDAA"
            emphasis_2 "#A49E94"
            emphasis_3 "#C8BDAA"
        }
        table_cell_unselected {
            base "#E6E1D6"
            background "#11100E"
            emphasis_0 "#FF4D1F"
            emphasis_1 "#C8BDAA"
            emphasis_2 "#A49E94"
            emphasis_3 "#C8BDAA"
        }
        table_cell_selected {
            base "#F2EFE8"
            background "#24221E"
            emphasis_0 "#FF4D1F"
            emphasis_1 "#C8BDAA"
            emphasis_2 "#A49E94"
            emphasis_3 "#C8BDAA"
        }
        list_unselected {
            base "#E6E1D6"
            background "#11100E"
            emphasis_0 "#FF4D1F"
            emphasis_1 "#C8BDAA"
            emphasis_2 "#A49E94"
            emphasis_3 "#C8BDAA"
        }
        list_selected {
            base "#F2EFE8"
            background "#24221E"
            emphasis_0 "#FF4D1F"
            emphasis_1 "#C8BDAA"
            emphasis_2 "#A49E94"
            emphasis_3 "#C8BDAA"
        }
        frame_unselected {
            base "#6B655C"
            background "#11100E"
            emphasis_0 "#A49E94"
            emphasis_1 "#C8BDAA"
            emphasis_2 "#A49E94"
            emphasis_3 "#6B655C"
        }
        frame_selected {
            base "#F2EFE8"
            background "#11100E"
            emphasis_0 "#FF4D1F"
            emphasis_1 "#C8BDAA"
            emphasis_2 "#A49E94"
            emphasis_3 "#F2EFE8"
        }
        frame_highlight {
            base "#FF4D1F"
            background "#11100E"
            emphasis_0 "#FF4D1F"
            emphasis_1 "#FF4D1F"
            emphasis_2 "#FF4D1F"
            emphasis_3 "#FF4D1F"
        }
        exit_code_success {
            base "#9DB89A"
            background "#11100E"
            emphasis_0 "#A49E94"
            emphasis_1 "#11100E"
            emphasis_2 "#C8BDAA"
            emphasis_3 "#86B1D9"
        }
        exit_code_error {
            base "#F0717F"
            background "#11100E"
            emphasis_0 "#E2B04F"
            emphasis_1 "#11100E"
            emphasis_2 "#11100E"
            emphasis_3 "#11100E"
        }
        multiplayer_user_colors {
            player_1 "#C8BDAA"
            player_2 "#86B1D9"
            player_3 "#9DB89A"
            player_4 "#E2B04F"
            player_5 "#A9BCCB"
            player_6 "#DDB77E"
            player_7 "#B4C29A"
            player_8 "#F0717F"
            player_9 "#A49E94"
            player_10 "#F2EFE8"
        }
    }
}

plugins {
    compact-bar location="zellij:compact-bar" {
        tooltip "Alt /"
    }
}

keybinds clear-defaults=true {
    normal {
    }

    locked {
        bind "Alt g" { SwitchToMode "Normal"; }
    }

    pane {
        bind "Alt p" { SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down" { MoveFocus "Down"; }
        bind "k" "Up" { MoveFocus "Up"; }
        bind "p" "Tab" { SwitchFocus; }
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "d" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "r" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
    }

    tab {
        bind "Alt t" { SwitchToMode "Normal"; }
        bind "h" "Left" "k" "Up" { GoToPreviousTab; }
        bind "l" "Right" "j" "Down" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "b" { BreakPane; SwitchToMode "Normal"; }
        bind "]" { BreakPaneRight; SwitchToMode "Normal"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; }
    }

    resize {
        bind "Alt r" { SwitchToMode "Normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    move {
        bind "Alt m" { SwitchToMode "Normal"; }
        bind "n" "Tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
    }

    scroll {
        bind "Alt s" { SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "/" "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" "Ctrl d" { HalfPageScrollDown; }
        bind "u" "Ctrl u" { HalfPageScrollUp; }
        bind "f" "l" "Right" "PageDown" "Space" { PageScrollDown; }
        bind "b" "h" "Left" "PageUp" { PageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; SwitchToMode "Normal"; }
    }

    search {
        bind "Alt s" { SwitchToMode "Normal"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "n" { Search "down"; }
        bind "N" "p" { Search "up"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" "Ctrl d" { HalfPageScrollDown; }
        bind "u" "Ctrl u" { HalfPageScrollUp; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "G" { ScrollToBottom; SwitchToMode "Normal"; }
    }

    entersearch {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    renametab {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
    }

    renamepane {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
    }

    session {
        bind "Alt o" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }

    // Direct actions, available everywhere except locked.
    shared_except "locked" {
        bind "Alt g" { SwitchToMode "Locked"; }

        // Focus — right hand (hjkl) or arrows; crosses to the next tab at edges.
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }

        // Panes — left hand.
        bind "Alt n" { NewPane; }
        bind "Alt v" { NewPane "Right"; }
        bind "Alt c" { NewPane "Down"; }
        bind "Alt z" { ToggleFocusFullscreen; }
        bind "Alt w" { ToggleFloatingPanes; }
        bind "Alt e" { TogglePaneEmbedOrFloating; }
        bind "Alt x" { CloseFocus; }

        // Tabs — left hand.
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt Tab" { ToggleTab; }

        // Layout.
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
    }

    shared_except "normal" "locked" {
        bind "Enter" "Esc" { SwitchToMode "Normal"; }
    }

    // Modes — each key enters its mode and, pressed again, leaves it.
    shared_except "pane" "locked" {
        bind "Alt p" { SwitchToMode "Pane"; }
    }
    shared_except "tab" "locked" {
        bind "Alt t" { SwitchToMode "Tab"; }
    }
    shared_except "resize" "locked" {
        bind "Alt r" { SwitchToMode "Resize"; }
    }
    shared_except "move" "locked" {
        bind "Alt m" { SwitchToMode "Move"; }
    }
    shared_except "scroll" "locked" {
        bind "Alt s" { SwitchToMode "Scroll"; }
    }
    shared_except "session" "locked" {
        bind "Alt o" { SwitchToMode "Session"; }
    }
}
