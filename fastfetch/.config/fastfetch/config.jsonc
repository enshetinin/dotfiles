// Yev Design System v0.2 — mirrors nvim/colors/yev.lua (dark).
// Grouping by whitespace (breaks), no separators or boxes.
// Yev Signal appears once: the square left behind by the diagonal cut.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        // Rectilinear block, 45° cut drawn with full/half blocks (one column
        // per half row ≈ 45° in a 1:2 cell). Only U+2580–259F, which terminals
        // draw natively, so the edge stays crisp regardless of font.
        // The signal square (██ = 2 cols × 1 row ≈ square) closes the right edge.
        "source": "$1████████████████\n$1████████████████\n$1████████████████\n$1███████████████▀\n$1█████████████▀\n$1███████████▀\n$1█████████▀\n$1███████▀      $2██",
        "color": {
            "1": "38;2;107;101;92", // edge    #6B655C
            "2": "38;2;255;77;31"   // signal  #FF4D1F
        },
        "padding": { "top": 1, "left": 3, "right": 6 }
    },
    "display": {
        "separator": "",
        "brightColor": false,
        "key": { "width": 10 },
        "color": {
            "keys": "38;2;164;158;148",   // muted  #A49E94
            "title": "38;2;242;239;232",  // strong #F2EFE8
            "output": "38;2;230;225;214", // fg     #E6E1D6
            "separator": "38;2;79;74;67"  // faint  #4F4A43
        },
        "bar": {
            "char": { "elapsed": "■", "total": "·" },
            "border": { "left": "", "right": "" },
            "color": {
                "elapsed": "38;2;200;189;170", // sand  #C8BDAA
                "total": "38;2;79;74;67"       // faint #4F4A43
            },
            "width": 14
        },
        "percent": {
            "type": ["bar", "num", "num-color"],
            "color": {
                "green": "38;2;157;184;154",  // ok    #9DB89A
                "yellow": "38;2;226;176;79",  // warn  #E2B04F
                "red": "38;2;240;113;127"     // error #F0717F
            }
        },
        "size": { "ndigits": 1 }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
            "color": {
                "user": "38;2;242;239;232",
                "at": "38;2;107;101;92",   // edge #6B655C
                "host": "38;2;200;189;170" // sand #C8BDAA
            }
        },
        "break",
        { "type": "os", "key": "os", "format": "{name} {codename} {version}" },
        { "type": "host", "key": "machine", "format": "{name}" },
        { "type": "kernel", "key": "kernel", "format": "{sysname} {release}" },
        {
            "type": "uptime",
            "key": "uptime",
            "format": "{?days}{days}d {?}{?hours}{hours}h {?}{minutes}m"
        },
        "break",
        { "type": "shell", "key": "shell", "format": "{pretty-name} {version}" },
        { "type": "terminal", "key": "terminal", "format": "{pretty-name}" },
        { "type": "terminalfont", "key": "font", "format": "{name}" },
        { "type": "editor", "key": "editor", "format": "{name}" },
        { "type": "packages", "key": "packages", "format": "{all}" },
        "break",
        { "type": "cpu", "key": "cpu", "format": "{name} · {cores-physical} núcleos" },
        { "type": "display", "key": "display", "format": "{width}×{height} @ {refresh-rate} Hz" },
        {
            "type": "memory",
            "key": "memory",
            "format": "{percentage-bar}  {percentage}  {used} / {total}"
        },
        {
            "type": "disk",
            "key": "disk",
            "folders": "/",
            "format": "{size-percentage-bar}  {size-percentage}  {size-used} / {size-total}"
        },
        {
            "type": "battery",
            "key": "battery",
            "format": "{capacity-bar}  {capacity}  {status}"
        },
        "break"
    ]
}
