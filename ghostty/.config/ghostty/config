# Ghostty — JetBrains look (matches nvim's colors/jetbrains.lua)
# Reload with cmd+shift+, — list every option with: ghostty +show-config --default --docs

theme = dark:jetbrains-dark,light:jetbrains-light

# --- Font ---------------------------------------------------------------
# Plain JetBrains Mono, the IDE font. Ghostty ships Nerd Font icons built in and
# sizes/centers them itself (the patched "Mono" variant squeezes them into one cell).
font-family = "JetBrains Mono"
font-size = 14
# Line spacing 1.2, like the IDE editor
adjust-cell-height = 20%
font-thicken = false
# Ligatures on, like JetBrains Mono in the IDE
font-feature = calt
font-feature = liga

# --- Window -------------------------------------------------------------
# Light transparency with blur so the desktop shows through softly
background-opacity = 0.92
background-blur = 20
macos-titlebar-style = transparent
macos-option-as-alt = left
window-padding-x = 14
window-padding-y = 10
# equal: same padding on all four sides (true shifts leftover pixels to the bottom)
window-padding-balance = equal
# background, not extend: extend stretches nvim's statusline/mode colors into the
# padding, making the bottom bar look thick with its text off-center
window-padding-color = background
window-width = 120
window-height = 35
window-position-x = 400
window-position-y = 250
window-save-state = never
confirm-close-surface = false

# --- Cursor -------------------------------------------------------------
# Thin blinking caret, like the IDE
cursor-style = bar
cursor-style-blink = true
shell-integration-features = no-cursor

# --- Behaviour ----------------------------------------------------------
scrollback-limit = 50000000
copy-on-select = clipboard
mouse-hide-while-typing = true
unfocused-split-opacity = 0.9

# --- Quick terminal (drop-down) -----------------------------------------
# Global hotkey needs Accessibility permission for Ghostty in System Settings.
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# --- Keys ---------------------------------------------------------------
keybind = cmd+enter=toggle_fullscreen
# Splits, vim-style navigation
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:bottom
keybind = cmd+alt+k=goto_split:top
keybind = cmd+alt+l=goto_split:right
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits
